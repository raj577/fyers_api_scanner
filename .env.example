# FYERS API credentials (never commit the real .env)
FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=http://localhost:8501

# Optional tuning
FYERS_TIMEZONE=Asia/Kolkata
FYERS_RESOLUTION=60
FYERS_HISTORY_CHUNK_DAYS=60
FYERS_CONTRACT_LOOKBACK_DAYS=120
# Keep 0 for an individual contract. 1 requests continuous futures, which
# would mix expiries and break contract-start AVWAP anchoring.
FYERS_HISTORY_CONT_FLAG=0
FYERS_HISTORY_CACHE_TTL=900
# Local JSON file for saved scanner presets
FYERS_PRESETS_FILE=presets/scanner_presets.json
FYERS_INSTRUMENT_CACHE_TTL=21600
FYERS_REQUEST_RATE_PER_SEC=5
FYERS_REQUEST_MAX_RETRIES=3
FYERS_INCLUDE_INDEX_FUTURES=false
FYERS_CHART_LOOKBACK=120
FYERS_LOG_LEVEL=INFO
